{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product listed by a shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string", "description": "Primary Base64 image string" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "Product gallery Base64 images" },
        "photoStatuses": {
          "type": "array",
          "items": { "type": "string", "enum": ["pending", "approved", "rejected"] },
          "description": "Per-photo Master approval statuses"
        },
        "photoStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "shopId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "image", "shopId"]
    },
    "Order": {
      "title": "Order",
      "description": "A purchase request from a customer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productName": { "type": "string" },
        "price": { "type": "number" },
        "shopName": { "type": "string" },
        "phone": { "type": "string" },
        "customerName": { "type": "string" },
        "location": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "Accepted", "Refused"] },
        "masterMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "time": { "type": "string", "description": "Display time string" }
      },
      "required": ["productName", "price", "shopName", "phone", "status"]
    },
    "User": {
      "title": "User",
      "description": "A customer or seller account.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "location": { "type": "string" },
        "shopId": { "type": "string", "description": "Linked shop ID if user is a seller" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "password"]
    },
    "ShopSettings": {
      "title": "Shop Settings",
      "description": "Visual settings for a shop.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string", "description": "Approved Base64 store logo" },
        "hero": { "type": "string", "description": "Approved Base64 hero image" },
        "pendingLogo": { "type": "string", "description": "Pending Base64 store logo awaiting Master approval" },
        "logoStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "pendingHero": { "type": "string", "description": "Pending Base64 hero image awaiting Master approval" },
        "heroStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "Customer star rating and comment for a product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "shopId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/inventory/{productId}": {
      "schema": "Product",
      "description": "Collection of all products from all shops."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of all customer orders."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials."
    },
    "/shop_settings/{shopId}": {
      "schema": "ShopSettings",
      "description": "Customized shop headers and names."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer star ratings and product comments."
    }
  }
}
